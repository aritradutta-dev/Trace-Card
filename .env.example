# Primary Gemini API key
GEMINI_API_KEY=

# Multiple Gemini API keys for automatic failover (comma, semicolon, or newline separated)
# If one key encounters a quota limit or downtime, TraceCard automatically fails over to the next healthy key.
GEMINI_API_KEYS=

# Optional rate limiting (default: 20 requests per minute per IP)
RATE_LIMIT_PER_MINUTE=20

# Model IDs are configurable in one place.
GEMINI_MODEL_QUICK=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-flash
